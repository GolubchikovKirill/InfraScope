# Local development stack (docker-compose.local.yml). scripts/dev-up.ps1 /
# dev-up.sh copy this to .env on first run and fill in the generated keys.
#
# Never use the production .env here. It carries the live 1C, Honest Sign,
# RustDesk and QR-generator credentials; a laptop stack with them would talk
# to those systems for real. docker-compose.local.yml forces
# ENVIRONMENT=development regardless, which keeps the stack off switches and
# APs, but external integrations are only as safe as the tokens left out here.

ENVIRONMENT=development
# true only to work against a lab switch on purpose - see Settings.ALLOW_HARDWARE_WRITES
ALLOW_HARDWARE_WRITES=false

SECRET_KEY=__GENERATED__
# Fernet key for secrets at rest. Deliberately not the production one: switch
# passwords in a restored prod dump stay unreadable here, so this stack cannot
# log in to a real switch even by accident.
CREDENTIALS_ENCRYPTION_KEYS=__GENERATED__

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=infrascope

FIRST_SUPERUSER_EMAIL=admin@infrascope.dev
FIRST_SUPERUSER_PASSWORD=LocalAdmin-2026!

# Scheduled polling of real devices: read-only (SNMP/TCP), but it puts a second
# poller on the store links. Turn on while working on polling.
AUTO_POLL_ENABLED=false
ML_ENABLED=true
REMOTE_ACCESS_ENABLED=false
MEDIA_SERVICE_ENABLED=false

# Resolver the containers use for device hostnames. Put the corporate DNS here
# (ipconfig /all -> "DNS Servers") if hostnames of tills and PCs should resolve.
DNS_SERVER=8.8.8.8
DNS_SEARCH_DOMAIN=

WORKER_CONCURRENCY=2
UVICORN_WORKERS=1
