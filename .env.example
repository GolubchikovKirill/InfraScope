# ── InfraScope Configuration ──────────────────────────
# Copy this file to .env and adjust values for your environment.

PROJECT_NAME=InfraScope
ENVIRONMENT=production
COMPOSE_PROJECT_NAME=infrascope

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Encrypts secrets at rest (switch SSH/enable passwords). Comma-separate to
# rotate keys (newest first encrypts, all are tried for decryption).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to keep storing these fields as plaintext (not recommended for production).
CREDENTIALS_ENCRYPTION_KEYS=
# Keep false for plain HTTP/LAN access. Set true only when the site is served over HTTPS.
AUTH_COOKIE_SECURE=false

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=infrascope
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=infrascope
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── First Admin User ─────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@infrascope.dev
FIRST_SUPERUSER_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
UVICORN_WORKERS=2
WORKER_CONCURRENCY=6
WORKER_POOL=threads
WORKER_METRICS_PORT=9108
ML_ENABLED=true
ML_SERVICE_URL=http://ml-service:8010
POLLING_SERVICE_ENABLED=true
POLLING_SERVICE_URL=http://polling-service:8011
DISCOVERY_SERVICE_ENABLED=true
DISCOVERY_SERVICE_URL=http://discovery-service:8012
NETWORK_CONTROL_SERVICE_ENABLED=true
NETWORK_CONTROL_SERVICE_URL=http://network-control-service:8013
MEDIA_SERVICE_ENABLED=true
MEDIA_SERVICE_URL=http://media-service:8014
MEDIA_SERVICE_BIND=0.0.0.0
MEDIA_SERVICE_PORT=8014
MEDIA_CLIENT_TOKEN=CHANGE_ME
MEDIA_LIBRARY_DIR=/var/lib/infrascope/media-library
MEDIA_LIBRARY_MAX_UPLOAD_MB=1024
INTERNAL_SERVICE_TOKEN=CHANGE_ME
INTERNAL_HTTP_TIMEOUT_SECONDS=30
INTERNAL_HTTP_RETRIES=1
INTERNAL_HTTP_RETRY_BACKOFF_SECONDS=0.5
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EVENT_TOPIC=infrascope.events
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_SERVICE_NAMESPACE=infrascope
PROMETHEUS_API_URL=http://prometheus:9090
JAEGER_API_URL=http://jaeger:16686
JAEGER_UI_URL=http://127.0.0.1:16686
KAFKA_UI_URL=http://127.0.0.1:8080
ML_MIN_TRAIN_ROWS=50
ML_RETRAIN_HOUR_UTC=2
ML_SCORE_INTERVAL_MINUTES=30

# ── DNS ──────────────────────────────────────────────
# Local DNS server for resolving Windows hostnames inside Docker.
# Usually your default gateway / AD DNS server.
# Find with: ipconfig /all (Windows) or cat /etc/resolv.conf (Linux)
DNS_SERVER=
# Optional DNS suffix list to resolve short hostnames (comma-separated).
# Example: corp.local,branch.local
DNS_SEARCH_SUFFIXES=
# Optional single DNS search domain for Docker resolver.
# Example: corp.local
DNS_SEARCH_DOMAIN=
QR_SQL_LOGIN=CHANGE_ME
QR_SQL_PASSWORD=CHANGE_ME
# Optional per-channel MSSQL endpoints for QR generation.
# If channel database is empty, QR_SQL_DATABASE is used as a fallback.
QR_SQL_DUTY_FREE_SERVER=10.10.94.228
QR_SQL_DUTY_FREE_DATABASE=
QR_SQL_DUTY_PAID_SERVER=10.10.94.229
QR_SQL_DUTY_PAID_DATABASE=
QR_SQL_DATABASE=CashDB51
QR_SQL_TIMEOUT_SECONDS=20
QR_EXPORT_TIMEOUT_SECONDS=180
ONEC_DUTY_FREE_API_URL=
ONEC_DUTY_FREE_API_TOKEN=
ONEC_DUTY_PAID_API_URL=
ONEC_DUTY_PAID_API_TOKEN=
# Optional 1C base metadata (for operations/reference and diagnostics).
# Example (Duty Free): Srvr="vnk-srv-1c02";Ref="trade_rsm_dfree";
ONEC_DUTY_FREE_IB_CONNECTION=
ONEC_DUTY_FREE_DOMAIN=regstaer-m
ONEC_DUTY_FREE_TERMINAL_SERVER=
ONEC_DUTY_PAID_IB_CONNECTION=
ONEC_DUTY_PAID_DOMAIN=regstaer
ONEC_DUTY_PAID_TERMINAL_SERVER=
ONEC_EXCHANGE_API_URL=
ONEC_EXCHANGE_API_TOKEN=
ONEC_EXCHANGE_TIMEOUT_SECONDS=20

# ── Honest Sign Local Module ─────────────────────────
# The API and navigation item are available only to these accounts.
HONEST_SIGN_ALLOWED_EMAILS=golubchikovka@regstaer.ru
# Comma-separated IPv4 targets. Optional labels use IP|Label.
# Example: 172.23.8.21|Checkout 1,172.23.8.22|Checkout 2
HONEST_SIGN_TARGETS=
HONEST_SIGN_API_LOGIN=
HONEST_SIGN_API_PASSWORD=
HONEST_SIGN_TOKEN=
HONEST_SIGN_PORT=5995
HONEST_SIGN_TIMEOUT_SECONDS=10
HONEST_SIGN_STATUS_WAIT_SECONDS=15
HONEST_SIGN_MAX_CONCURRENCY=8
SWITCH_WRITE_LOCK_SECONDS=20
SWITCH_SAFETY_COOLDOWN_SECONDS=8

# ── Network Scanner ──────────────────────────────────
# Subnets to scan (comma-separated CIDR, e.g. 10.10.98.0/24, 10.10.99.0/24)
SCAN_SUBNET=
# Comma-separated list of ports to probe
SCAN_PORTS=9100,631,80,443
# Safety/efficiency limits for network scan
SCAN_MAX_HOSTS=4096
SCAN_TCP_TIMEOUT=1.0
SCAN_TCP_RETRIES=1
SCAN_TCP_CONCURRENCY=128
POLL_JITTER_MAX_MS=120
POLL_OFFLINE_CONFIRMATIONS=2
POLL_CIRCUIT_FAILURE_THRESHOLD=4
POLL_CIRCUIT_OPEN_SECONDS=45
POLL_RESILIENCE_STATE_TTL_SECONDS=7200
PRINTER_POLL_MAX_WORKERS=16
MEDIA_POLL_MAX_WORKERS=12
SWITCH_POLL_MAX_CONCURRENCY=8
COMPUTER_POLL_CONCURRENCY=16
CASH_REGISTER_POLL_CONCURRENCY=16

# ── Domain ────────────────────────────────────────────
# Local domain name (add to /etc/hosts: 127.0.0.1 infrascope.local)
DOMAIN=infrascope.local

# ── Network Access ───────────────────────────────────
# IP of the host machine (for SSL certificate SAN and CORS).
# Set this to allow access from other computers on the LAN.
# Find with: ipconfig (Windows) or ip addr (Linux)
HOST_IP=

# ── CORS ──────────────────────────────────────────────
# Add https://<HOST_IP> if you want LAN access
BACKEND_CORS_ORIGINS=["https://infrascope.local","https://localhost","http://infrascope.local","http://localhost"]

# ── Frontend ──────────────────────────────────────────
FRONTEND_PORT=80

# ── Monitoring (Prometheus/Grafana) ───────────────────
# Bind to localhost by default; expose publicly only behind VPN/reverse proxy.
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_IMAGE=grafana/grafana-oss:latest
KAFKA_UI_BIND=127.0.0.1
KAFKA_UI_PORT=8080
JAEGER_BIND=127.0.0.1
JAEGER_PORT=16686
